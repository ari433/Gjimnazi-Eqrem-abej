/**
 * Generates supabase/seed.sql from src/lib/content/seed.ts so the database
 * and the local fallback never drift apart. Example items (is_example) are
 * skipped: they exist only to preview layouts locally.
 *
 * Run: node --experimental-strip-types scripts/generate-seed.mts
 */
import { writeFileSync } from "node:fs";
import * as seed from "../src/lib/content/seed.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number" || typeof v === "boolean") return String(v);
  if (Array.isArray(v)) return `array[${v.map(q).join(", ")}]::text[]`;
  if (typeof v === "object") return `${q(JSON.stringify(v))}::jsonb`;
  return `'${String(v).replace(/'/g, "''")}'`;
};

const lines: string[] = [
  "-- Generated by scripts/generate-seed.mts — do not edit by hand.",
  "-- Verified content and clearly-pending placeholders for Gjimnazi \"Eqrem Çabej\".",
  "begin;",
];

for (const [key, value] of Object.entries(seed.siteContent)) {
  lines.push(`insert into public.site_content (key, value) values (${q(key)}, ${q(JSON.stringify(value))}::jsonb) on conflict (key) do nothing;`);
}

for (const s of seed.stats) {
  lines.push(
    `insert into public.stats (label, value, suffix, source, year, sort_order, verification) values (${[s.label, s.value, s.suffix, s.source, s.year, s.sort_order, s.verification].map(q).join(", ")});`,
  );
}

for (const p of seed.programs) {
  lines.push(
    `insert into public.programs (slug, name, short_name, tagline, summary, overview, outcomes, pathways, grades, sort_order, verification, source_note, status, published_at) values (${[
      p.slug, p.name, p.short_name, p.tagline, p.summary, p.overview, p.outcomes, p.pathways, p.grades, p.sort_order, p.verification, p.source_note, p.status, p.published_at,
    ].map(q).join(", ")}) on conflict (slug) do nothing;`,
  );
  for (const s of seed.subjects.filter((x) => x.program_id === p.id)) {
    lines.push(
      `insert into public.subjects (program_id, name, sort_order, verification) select id, ${q(s.name)}, ${s.sort_order}, ${q(s.verification)} from public.programs where slug = ${q(p.slug)};`,
    );
  }
}

for (const s of seed.staff) {
  lines.push(
    `insert into public.staff (full_name, role_title, department, is_leadership, sort_order, verification, source_note, status, published_at) values (${[
      s.full_name, s.role_title, s.department, s.is_leadership, s.sort_order, s.verification, s.source_note, s.status, s.published_at,
    ].map(q).join(", ")});`,
  );
}

for (const c of seed.clubs) {
  lines.push(
    `insert into public.clubs (slug, name, summary, description, is_media_club, sort_order, verification, status, published_at) values (${[
      c.slug, c.name, c.summary, c.description, c.is_media_club, c.sort_order, c.verification, c.status, c.published_at,
    ].map(q).join(", ")}) on conflict (slug) do nothing;`,
  );
}

for (const d of seed.documents) {
  lines.push(
    `insert into public.documents (title, description, category, file_url, file_type, status, published_at) values (${[
      d.title, d.description, d.category, d.file_url, d.file_type, d.status, d.published_at,
    ].map(q).join(", ")});`,
  );
}

lines.push("commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`Wrote supabase/seed.sql (${lines.length} lines)`);
