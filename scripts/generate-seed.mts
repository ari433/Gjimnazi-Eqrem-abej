/**
 * Generates supabase/seed.sql from src/lib/content/seed.ts so the database and
 * the local fallback never drift apart. Example items (is_example) are skipped.
 *
 * Run: npm run db:seed
 */
import { writeFileSync } from "node:fs";
import * as seed from "../src/lib/content/seed.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number" || typeof v === "boolean") return String(v);
  if (Array.isArray(v)) return v.length ? `array[${v.map(q).join(", ")}]::text[]` : "'{}'::text[]";
  if (typeof v === "object") return `${q(JSON.stringify(v))}::jsonb`;
  return `'${String(v).replace(/'/g, "''")}'`;
};

/** Seed-only keys that are not database columns. */
const SKIP = new Set(["id", "is_example", "untranslated", "created_at", "updated_at"]);

function insert(table: string, row: Record<string, unknown>, opts: { conflict?: string; omit?: string[]; extra?: Record<string, string> } = {}) {
  const cols = Object.keys(row).filter((k) => !SKIP.has(k) && !(opts.omit ?? []).includes(k));
  const names = [...cols, ...Object.keys(opts.extra ?? {})];
  const values = [...cols.map((c) => q(row[c])), ...Object.values(opts.extra ?? {})];
  return `insert into public.${table} (${names.join(", ")}) values (${values.join(", ")})${opts.conflict ? ` on conflict (${opts.conflict}) do nothing` : ""};`;
}

const out: string[] = ["-- Generated by scripts/generate-seed.mts — do not edit by hand.", "begin;"];

// Site blocks: Albanian under the bare key, German text blocks under "<key>_de".
for (const [key, value] of Object.entries(seed.siteContent)) {
  out.push(`insert into public.site_content (key, value) values (${q(key)}, ${q(JSON.stringify(value))}::jsonb) on conflict (key) do nothing;`);
}
for (const key of ["hero", "intro", "history", "enrollment", "student_info"] as const) {
  out.push(`insert into public.site_content (key, value) values (${q(`${key}_de`)}, ${q(JSON.stringify(seed.siteContentDe[key]))}::jsonb) on conflict (key) do nothing;`);
}

for (const s of seed.stats) out.push(insert("stats", s as unknown as Record<string, unknown>));

const programSlug = new Map(seed.programs.map((p) => [p.id, p.slug]));
for (const p of seed.programs) out.push(insert("programs", p as unknown as Record<string, unknown>, { conflict: "slug" }));
for (const s of seed.subjects) {
  const { program_id, ...rest } = s;
  const cols = Object.keys(rest).filter((k) => !SKIP.has(k));
  out.push(
    `insert into public.subjects (program_id, ${cols.join(", ")}) select id, ${cols.map((c) => q((rest as Record<string, unknown>)[c])).join(", ")} from public.programs where slug = ${q(programSlug.get(program_id))};`,
  );
}

for (const s of seed.staff) out.push(insert("staff", s as unknown as Record<string, unknown>));
for (const c of seed.clubs) out.push(insert("clubs", c as unknown as Record<string, unknown>, { conflict: "slug" }));
for (const n of seed.news.filter((x) => !x.is_example)) out.push(insert("news", n as unknown as Record<string, unknown>, { conflict: "slug" }));
for (const a of seed.announcements.filter((x) => !x.is_example)) out.push(insert("announcements", a as unknown as Record<string, unknown>));
for (const e of seed.events.filter((x) => !x.is_example)) out.push(insert("events", e as unknown as Record<string, unknown>, { conflict: "slug" }));
for (const p of seed.projects) out.push(insert("projects", p as unknown as Record<string, unknown>, { conflict: "slug" }));
for (const a of seed.achievements) out.push(insert("achievements", a as unknown as Record<string, unknown>));
for (const m of seed.media) out.push(insert("media_items", m as unknown as Record<string, unknown>));
for (const d of seed.documents) out.push(insert("documents", d as unknown as Record<string, unknown>));

out.push(
  "-- Photos referenced as /media/... live in the site's public/ folder. After",
  "-- moving them to Supabase Storage, update the URLs from the admin panel.",
  "commit;",
  "",
);
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), out.join("\n"));
console.log(`Wrote supabase/seed.sql (${out.length} lines)`);
